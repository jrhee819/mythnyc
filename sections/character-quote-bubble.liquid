{% comment %}
  Character Quote Bubble
  -----------------------
  Renders your character image with a speech bubble that displays a random
  quote from the "quotes" list every time the page loads/refreshes.

  Install:
    1. Shopify admin → Online Store → Themes → Edit code.
    2. Under "Sections", click "Add a new section", name it
       "character-quote-bubble" and paste this file's contents.
    3. Go to the theme customizer → Home page → Add section →
       "Character Quote Bubble" → upload your character PNG (and, optionally,
       a speech-bubble PNG) and edit the quotes list.
{% endcomment %}

{%- liquid
  assign bubble_side = section.settings.bubble_position
  assign raw_quotes = section.settings.quotes | newline_to_br | split: '<br />'

  case section.settings.character_align
    when 'left'
      assign char_align = 'flex-start'
    when 'right'
      assign char_align = 'flex-end'
    else
      assign char_align = 'center'
  endcase

  case section.settings.text_align
    when 'left'
      assign text_justify = 'start'
    when 'right'
      assign text_justify = 'end'
    else
      assign text_justify = 'center'
  endcase
-%}

<div
  class="quote-bubble-section"
  id="quote-bubble-section-{{ section.id }}"
  style="
    --char-max-width: {{ section.settings.character_max_width }}px;
    --char-align: {{ char_align }};
    --char-offset-x: {{ section.settings.character_offset_x }}px;
    --char-offset-y: {{ section.settings.character_offset_y }}px;
    --bubble-width: {{ section.settings.bubble_width }}px;
    --bubble-height: {{ section.settings.bubble_height }}px;
    --bubble-offset-x: {{ section.settings.bubble_offset_x }}px;
    --bubble-offset-y: {{ section.settings.bubble_offset_y }}px;
    --bubble-bg: {{ section.settings.bubble_bg_color }};
    --bubble-color: {{ section.settings.bubble_text_color }};
    --bubble-font-family: {{ section.settings.font_family.family }}, {{ section.settings.font_family.fallback_families }};
    --bubble-font-weight: {{ section.settings.font_family.weight }};
    --bubble-font-style: {{ section.settings.font_family.style }};
    --bubble-font-size: {{ section.settings.font_size }}px;
    --bubble-text-align: {{ section.settings.text_align }};
    --bubble-text-justify: {{ text_justify }};
    --bubble-text-offset-x: {{ section.settings.text_offset_x }}px;
    --bubble-text-offset-y: {{ section.settings.text_offset_y }}px;
  "
>
  {%- comment -%}
    Traced from the uploaded reference: a circle body with a small hooked
    tail on the lower-left. clipPathUnits="objectBoundingBox" lets the
    same normalized (0–1) path scale to whatever size the bubble box ends
    up being. A second, horizontally mirrored copy is used when the
    bubble sits to the left of the character, so the tail always points
    back toward it.
  {%- endcomment -%}
  <svg width="0" height="0" style="position: absolute;" aria-hidden="true" focusable="false">
    <defs>
      <clipPath id="quote-bubble-clip-{{ section.id }}" clipPathUnits="objectBoundingBox">
        <path d="M0.170,0.610 A0.416,0.473 0 1 0 0.170,0.366 C0.086,0.358 0,0.423 0.014,0.520 C0.029,0.585 0.100,0.610 0.170,0.610 Z" />
      </clipPath>
      <clipPath id="quote-bubble-clip-mirrored-{{ section.id }}" clipPathUnits="objectBoundingBox">
        <path d="M0.830,0.610 A0.416,0.473 0 1 1 0.830,0.366 C0.914,0.358 1,0.423 0.986,0.520 C0.971,0.585 0.900,0.610 0.830,0.610 Z" />
      </clipPath>
    </defs>
  </svg>

  <div class="quote-bubble-stage">
    {%- if section.settings.character_image != blank -%}
      <img
        class="quote-bubble-character"
        src="{{ section.settings.character_image | image_url: width: 1200 }}"
        srcset="
          {{ section.settings.character_image | image_url: width: 400 }} 400w,
          {{ section.settings.character_image | image_url: width: 800 }} 800w,
          {{ section.settings.character_image | image_url: width: 1200 }} 1200w
        "
        sizes="(max-width: 749px) 220px, {{ section.settings.character_max_width }}px"
        alt="{{ section.settings.character_image.alt | default: shop.name | escape }}"
        width="{{ section.settings.character_image.width }}"
        height="{{ section.settings.character_image.height }}"
        loading="eager"
      >
    {%- else -%}
      <div class="quote-bubble-character quote-bubble-character--placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {%- endif -%}

    <div class="quote-bubble quote-bubble--{{ bubble_side }}{% if section.settings.bubble_image != blank %} quote-bubble--has-image{% endif %}">
      {%- if section.settings.bubble_image != blank -%}
        <img
          class="quote-bubble-image"
          src="{{ section.settings.bubble_image | image_url: width: 800 }}"
          alt=""
          loading="eager"
        >
      {%- endif -%}
      <p class="quote-bubble-text" data-quote-bubble-text></p>
    </div>
  </div>
</div>

<script id="quote-bubble-data-{{ section.id }}" type="application/json">
  {{ raw_quotes | json }}
</script>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.getElementById('quote-bubble-section-' + sectionId);
    var dataEl = document.getElementById('quote-bubble-data-' + sectionId);
    if (!root || !dataEl) return;

    var textEl = root.querySelector('[data-quote-bubble-text]');
    if (!textEl) return;

    var quotes = [];
    try {
      quotes = JSON.parse(dataEl.textContent)
        .map(function (q) { return q.trim(); })
        .filter(Boolean);
    } catch (e) {
      quotes = [];
    }

    if (!quotes.length) {
      textEl.textContent = 'Add some quotes in the theme customizer!';
      return;
    }

    var pick = quotes[Math.floor(Math.random() * quotes.length)];
    textEl.textContent = pick;
  })();
</script>

<style>
  {{ section.settings.font_family | font_face: font_display: 'swap' }}

  #quote-bubble-section-{{ section.id }} {
    display: flex;
    justify-content: var(--char-align);
    padding: {{ section.settings.padding_top }}px 1rem {{ section.settings.padding_bottom }}px;
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble-stage {
    position: relative;
    display: inline-flex;
    max-width: 100%;
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble-character {
    display: block;
    width: 100%;
    max-width: var(--char-max-width);
    height: auto;
    transform: translate(var(--char-offset-x), var(--char-offset-y));
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble-character--placeholder svg {
    width: var(--char-max-width);
    height: auto;
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble {
    position: absolute;
    width: var(--bubble-width);
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble--top-right {
    top: var(--bubble-offset-y);
    left: calc(100% + var(--bubble-offset-x));
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble--top-left {
    top: var(--bubble-offset-y);
    right: calc(100% + var(--bubble-offset-x));
  }

  /* Speech-bubble image variant: text is layered on top of the artwork */
  #quote-bubble-section-{{ section.id }} .quote-bubble--has-image {
    display: grid;
    height: var(--bubble-height);
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble-image {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble--has-image .quote-bubble-text {
    grid-area: 1 / 1;
    align-self: center;
    justify-self: var(--bubble-text-justify);
    padding: 12% 16%;
  }

  /* CSS-drawn fallback bubble, used when no bubble image is uploaded.
     Clipped to a traced speech-bubble silhouette (circle + hooked tail)
     via the clipPath defs above. aspect-ratio matches the shape's own
     design proportions so it isn't distorted at the default size;
     min-height is a floor that lets the box stretch taller — and the
     shape with it — if a quote needs more room. */
  #quote-bubble-section-{{ section.id }} .quote-bubble:not(.quote-bubble--has-image) .quote-bubble-text {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: var(--bubble-text-justify);
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 700 / 615;
    min-height: var(--bubble-height);
    background: var(--bubble-bg);
    color: var(--bubble-color);
    padding: 16% 14%;
    clip-path: url(#quote-bubble-clip-{{ section.id }});
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.15));
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble--top-left:not(.quote-bubble--has-image) .quote-bubble-text {
    clip-path: url(#quote-bubble-clip-mirrored-{{ section.id }});
  }

  #quote-bubble-section-{{ section.id }} .quote-bubble-text {
    margin: 0;
    font-family: var(--bubble-font-family);
    font-weight: var(--bubble-font-weight);
    font-style: var(--bubble-font-style);
    font-size: var(--bubble-font-size);
    line-height: 1.35;
    text-align: var(--bubble-text-align);
    transform: translate(var(--bubble-text-offset-x), var(--bubble-text-offset-y));
  }

  @media (max-width: 749px) {
    #quote-bubble-section-{{ section.id }} .quote-bubble-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    #quote-bubble-section-{{ section.id }} .quote-bubble-character,
    #quote-bubble-section-{{ section.id }} .quote-bubble-text {
      /* Position offsets are meant for desktop layout; ignore them on
         mobile where the character and bubble stack vertically instead. */
      transform: none;
    }

    #quote-bubble-section-{{ section.id }} .quote-bubble {
      position: static;
      width: min(90vw, var(--bubble-width));
      height: auto;
    }

    #quote-bubble-section-{{ section.id }} .quote-bubble:not(.quote-bubble--has-image) .quote-bubble-text {
      min-height: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Character Quote Bubble",
  "settings": [
    {
      "type": "header",
      "content": "Character"
    },
    {
      "type": "image_picker",
      "id": "character_image",
      "label": "Character image"
    },
    {
      "type": "range",
      "id": "character_max_width",
      "label": "Character max width",
      "min": 120,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 320
    },
    {
      "type": "select",
      "id": "character_align",
      "label": "Character position on page",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "character_offset_x",
      "label": "Character horizontal nudge",
      "info": "Fine-tune the character's position without moving the speech bubble, which stays anchored to it.",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "character_offset_y",
      "label": "Character vertical nudge",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Speech bubble"
    },
    {
      "type": "image_picker",
      "id": "bubble_image",
      "label": "Speech bubble image (optional)",
      "info": "Leave blank to use a drawn speech-bubble shape (circle + hooked tail) styled with the colors below."
    },
    {
      "type": "select",
      "id": "bubble_position",
      "label": "Bubble position",
      "options": [
        { "value": "top-right", "label": "Top right of character" },
        { "value": "top-left", "label": "Top left of character" }
      ],
      "default": "top-right"
    },
    {
      "type": "range",
      "id": "bubble_offset_x",
      "label": "Bubble horizontal offset",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "bubble_offset_y",
      "label": "Bubble vertical offset",
      "min": -150,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": -20
    },
    {
      "type": "range",
      "id": "bubble_width",
      "label": "Bubble width",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "range",
      "id": "bubble_height",
      "label": "Bubble height",
      "info": "For an uploaded bubble image, the artwork scales to fit inside this height without distorting. For the drawn bubble, this is a minimum height — it keeps its speech-bubble proportions at the default size and only stretches taller if a quote needs more room.",
      "min": 60,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "color",
      "id": "bubble_bg_color",
      "label": "Bubble background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bubble_text_color",
      "label": "Bubble text color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Quote font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Quote font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_offset_x",
      "label": "Text horizontal nudge",
      "info": "Fine-tune where the quote sits inside the bubble — handy for lining it up with an uploaded bubble image.",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "text_offset_y",
      "label": "Text vertical nudge",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Quotes"
    },
    {
      "type": "textarea",
      "id": "quotes",
      "label": "Quotes (one per line)",
      "info": "A random line is shown each time the page loads.",
      "default": "Welcome to the shop!\nNew drops every week.\nMade in NYC.\nGrab something before it's gone."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Character Quote Bubble"
    }
  ]
}
{% endschema %}
